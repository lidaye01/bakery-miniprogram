<!-- pages/orders/orders.wxml -->
<view class="orders-page">
  <!-- 顶部Tab -->
  <scroll-view class="tabs-scroll" scroll-x>
    <view class="tabs">
      <view 
        class="tab {{currentTab === item.id ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="id"
        bindtap="onTabChange"
        data-tab="{{item.id}}"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y>
    <view 
      class="order-card"
      wx:for="{{orderList}}"
      wx:key="id"
      bindtap="onOrderTap"
      data-order="{{item}}"
    >
      <!-- 订单头部 -->
      <view class="order-header">
        <view class="order-store">🍞 {{item.storeName}}</view>
        <view class="order-status status-{{item.status}}">{{item.statusText}}</view>
      </view>

      <!-- 商品列表 -->
      <view class="order-items">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="goods" wx:key="index" wx:if="{{index < 3}}">
          <text class="item-emoji">{{goods.emoji}}</text>
          <text class="item-name">{{goods.name}}</text>
          <text class="item-qty">x{{goods.quantity}}</text>
        </view>
        <view class="order-more" wx:if="{{item.items.length > 3}}">
          ...还有{{item.items.length - 3}}件商品
        </view>
      </view>

      <!-- 订单底部 -->
      <view class="order-footer">
        <view class="order-info">
          <text class="order-time">{{item.createTime}}</text>
          <text class="order-count">共{{item.totalCount}}件</text>
        </view>
        <view class="order-amount">
          <text class="amount-label">实付</text>
          <text class="amount-value">¥{{item.payAmount}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions" wx:if="{{item.showActions}}">
        <view 
          class="action-btn btn-cancel" 
          wx:if="{{item.status === 'pending'}}"
          bindtap="onCancelOrder"
          data-order="{{item}}"
        >取消订单</view>
        <view 
          class="action-btn btn-pay" 
          wx:if="{{item.status === 'pending'}}"
          bindtap="onPayOrder"
          data-order="{{item}}"
        >去支付</view>
        <view 
          class="action-btn btn-remind" 
          wx:if="{{item.status === 'preparing'}}"
          bindtap="onRemindOrder"
          data-order="{{item}}"
        >提醒制作</view>
        <view 
          class="action-btn btn-confirm" 
          wx:if="{{item.status === 'ready'}}"
          bindtap="onConfirmReceive"
          data-order="{{item}}"
        >确认取货</view>
        <view 
          class="action-btn btn-rate" 
          wx:if="{{item.status === 'completed'}}"
          bindtap="onRateOrder"
          data-order="{{item}}"
        >去评价</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{orderList.length === 0 && !loading}}">
      <view class="empty-icon">📋</view>
      <view class="empty-text">暂无订单</view>
      <button class="empty-btn" bindtap="goToMenu">去点单</button>
    </view>

    <!-- 加载状态 -->
    <view class="loading-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 底部安全区 -->
    <view class="safe-bottom"></view>
  </scroll-view>
</view>
