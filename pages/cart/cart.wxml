<!-- pages/cart/cart.wxml -->
<view class="cart-page">
  <!-- 头部 -->
  <view class="cart-header">
    <view class="header-title">购物车</view>
    <view class="header-action" bindtap="onClearCart" wx:if="{{cartItems.length > 0}}">
      清空
    </view>
  </view>

  <!-- 购物车列表 -->
  <view class="cart-list" wx:if="{{cartItems.length > 0}}">
    <view class="cart-item" wx:for="{{cartItems}}" wx:key="id">
      <view class="item-select">
        <view class="select-icon selected">✓</view>
      </view>
      <view class="item-image">
        <text class="item-emoji">{{item.emoji || '🍞'}}</text>
      </view>
      <view class="item-info">
        <view class="item-name">{{item.name}}</view>
        <view class="item-spec" wx:if="{{item.spec}}">{{item.spec}}</view>
        <view class="item-price">¥{{item.price}}</view>
      </view>
      <view class="item-actions">
        <view class="qty-btn" bindtap="onReduce" data-index="{{index}}">-</view>
        <text class="qty-num">{{item.quantity}}</text>
        <view class="qty-btn increase" bindtap="onIncrease" data-index="{{index}}">+</view>
      </view>
      <view class="item-delete" bindtap="onDeleteItem" data-index="{{index}}">
        🗑️
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{cartItems.length === 0}}">
    <view class="empty-icon">🛒</view>
    <view class="empty-text">购物车空空如也</view>
    <view class="empty-tip">快去挑选喜欢的美食吧</view>
    <button class="empty-btn" bindtap="onContinueOrder">去点单</button>
  </view>

  <!-- 底部结算栏 -->
  <view class="cart-footer safe-area-bottom" wx:if="{{cartItems.length > 0}}">
    <view class="footer-left">
      <view class="total-info">
        <text class="total-label">合计：</text>
        <text class="total-amount">¥{{selectedAmount}}</text>
      </view>
      <text class="total-tip">共{{selectedCount}}件</text>
    </view>
    <view class="checkout-btn" bindtap="onCheckout">
      去结算
    </view>
  </view>
</view>
