/* pages/order/order.wxss */
.order-page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  padding-bottom: 140rpx;
}

/* 区块 */
.section {
  background: var(--color-bg-white);
  margin: 20rpx 24rpx;
  border-radius: var(--radius-md);
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.section-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

/* 门店信息 */
.store-section {
  display: flex;
  align-items: flex-start;
}

.store-info {
  flex: 1;
}

.store-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.store-address {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.store-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.store-phone,
.store-distance {
  font-size: 24rpx;
  color: var(--color-text-light);
}

/* 取餐方式 */
.order-types {
  display: flex;
  gap: 16rpx;
}

.order-type {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg);
  transition: all 0.2s;
}

.order-type.active {
  background: var(--color-brand-light);
  border: 1px solid var(--color-brand);
}

.type-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.type-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.type-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 预约时间 */
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--color-text);
}

.picker-arrow {
  font-size: 32rpx;
  color: var(--color-text-light);
}

/* 订单商品 */
.order-items {
  border-top: 1px solid var(--color-border);
  padding-top: 16rpx;
}

.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-emoji {
  font-size: 40rpx;
}

.item-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.item-name {
  font-size: 28rpx;
  color: var(--color-text);
}

.item-qty {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.item-price {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* 备注 */
.remark-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--color-text);
}

/* 优惠抵扣 */
.discount-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1px solid var(--color-border);
}

.discount-item:last-child {
  border-bottom: none;
}

.discount-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.discount-icon {
  font-size: 32rpx;
}

.discount-info {
  display: flex;
  flex-direction: column;
}

.discount-name {
  font-size: 28rpx;
  color: var(--color-text);
}

.discount-tip {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.discount-toggle {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: var(--color-border);
  padding: 4rpx;
  transition: all 0.2s;
}

.discount-toggle.active {
  background: var(--color-brand);
}

.toggle-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: white;
  transition: all 0.2s;
}

.discount-toggle.active .toggle-dot {
  transform: translateX(40rpx);
}

.discount-arrow {
  font-size: 32rpx;
  color: var(--color-text-light);
}

/* 价格汇总 */
.price-section {
  margin-top: 20rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.price-row.total {
  border-top: 1px dashed var(--color-border);
  margin-top: 12rpx;
  padding-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.price-row .price-value {
  color: var(--color-text);
}

.price-row .price-value.discount {
  color: var(--color-error);
}

.price-row.total .price-value {
  color: var(--color-brand);
  font-size: 36rpx;
}

/* 底部支付按钮 */
.order-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: var(--color-bg-white);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.footer-amount {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.amount-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.amount-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.pay-btn {
  background: var(--color-brand);
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 64rpx;
  border-radius: 50rpx;
}

.pay-btn:active {
  opacity: 0.9;
}

/* 底部安全区 */
.safe-bottom {
  height: 40rpx;
}
