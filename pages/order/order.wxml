<wxs module="format" src="../utils/format.wxs"></wxs>
<!-- pages/order/order.wxml -->
<view class="order-page">
  <scroll-view class="page-content" scroll-y>
    <!-- 门店信息 -->
    <view class="section store-section">
      <view class="section-icon">📍</view>
      <view class="store-info">
        <view class="store-name">{{storeInfo.name}}</view>
        <view class="store-address">{{storeInfo.address}}</view>
        <view class="store-meta">
          <text class="store-phone">📞 {{storeInfo.phone}}</text>
          <text class="store-distance">{{storeInfo.distance}}</text>
        </view>
      </view>
    </view>

    <!-- 取餐方式 -->
    <view class="section">
      <view class="section-title">取餐方式</view>
      <view class="order-types">
        <view 
          class="order-type {{orderType === item.id ? 'active' : ''}}"
          wx:for="{{orderTypes}}"
          wx:key="id"
          bindtap="onOrderTypeChange"
          data-type="{{item.id}}"
        >
          <text class="type-icon">{{item.icon}}</text>
          <text class="type-name">{{item.name}}</text>
          <text class="type-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 预约时间 -->
    <view class="section">
      <view class="section-title">预约时间</view>
      <picker mode="selector" range="{{pickupTimeOptions}}" range-key="name" bindchange="onPickupTimeChange">
        <view class="picker-value">
          {{pickupTimeOptions[0].name}}
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 商品列表 -->
    <view class="section">
      <view class="section-title">订单商品</view>
      <view class="order-items">
        <view class="order-item" wx:for="{{cartItems}}" wx:key="id">
          <view class="item-left">
            <text class="item-emoji">{{item.emoji || '🍞'}}</text>
            <view class="item-info">
              <text class="item-name">{{item.name}}</text>
              <text class="item-qty">x{{item.quantity}}</text>
            </view>
          </view>
          <text class="item-price">{{format.formatPrice(format.multiply(item.price, item.quantity))}}</text>
        </view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="section">
      <view class="section-title">备注</view>
      <input 
        class="remark-input" 
        placeholder="口味要求/取货暗号等..." 
        value="{{remark}}"
        bindinput="onRemarkInput"
      />
    </view>

    <!-- 优惠抵扣 -->
    <view class="section">
      <!-- 积分抵扣 -->
      <view class="discount-item" bindtap="onTogglePoints">
        <view class="discount-left">
          <text class="discount-icon">💰</text>
          <view class="discount-info">
            <text class="discount-name">积分抵扣</text>
            <text class="discount-tip">可用{{points}}积分抵{{format.formatPrice(points/100)}}</text>
          </view>
        </view>
        <view class="discount-toggle {{usePoints ? 'active' : ''}}">
          <view class="toggle-dot"></view>
        </view>
      </view>
      
      <!-- 优惠券 -->
      <view class="discount-item" bindtap="onSelectCoupon">
        <view class="discount-left">
          <text class="discount-icon">🎫</text>
          <view class="discount-info">
            <text class="discount-name">优惠券</text>
            <text class="discount-tip" wx:if="{{selectedCoupon}}">-¥{{couponDiscount}}</text>
            <text class="discount-tip" wx:else>暂无可用优惠券</text>
          </view>
        </view>
        <text class="discount-arrow">›</text>
      </view>
    </view>

    <!-- 价格汇总 -->
    <view class="section price-section">
      <view class="price-row">
        <text class="price-label">商品金额</text>
        <text class="price-value">¥{{totalAmount}}</text>
      </view>
      <view class="price-row" wx:if="{{deliveryFee > 0}}">
        <text class="price-label">配送费</text>
        <text class="price-value">¥{{deliveryFee}}</text>
      </view>
      <view class="price-row" wx:if="{{pointsDiscount > 0}}">
        <text class="price-label">积分抵扣</text>
        <text class="price-value discount">-¥{{pointsDiscount}}</text>
      </view>
      <view class="price-row" wx:if="{{couponDiscount > 0}}">
        <text class="price-label">优惠券</text>
        <text class="price-value discount">-¥{{couponDiscount}}</text>
      </view>
      <view class="price-row total">
        <text class="price-label">合计</text>
        <text class="price-value">¥{{payAmount}}</text>
      </view>
    </view>

    <!-- 底部安全区 -->
    <view class="safe-bottom"></view>
  </scroll-view>

  <!-- 底部支付按钮 -->
  <view class="order-footer safe-area-bottom">
    <view class="footer-amount">
      <text class="amount-label">实付</text>
      <text class="amount-value">¥{{payAmount}}</text>
    </view>
    <view class="pay-btn" bindtap="onSubmitOrder">
      提交订单
    </view>
  </view>
</view>
