/* pages/coupons/coupons.wxss */
.coupons-page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* Tab切换 */
.tabs {
  display: flex;
  background: var(--color-bg-white);
  padding: 24rpx 32rpx;
  gap: 48rpx;
}

.tab {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  padding-bottom: 8rpx;
  border-bottom: 4rpx solid transparent;
}

.tab.active {
  color: var(--color-brand);
  border-bottom-color: var(--color-brand);
  font-weight: 600;
}

/* 优惠券列表 */
.coupon-list {
  padding: 24rpx;
}

.coupon-card {
  display: flex;
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 24rpx;
  position: relative;
}

.coupon-card.used,
.coupon-card.expired {
  opacity: 0.6;
}

.coupon-card.used .coupon-left {
  background: var(--color-text-light);
}

.coupon-left {
  width: 200rpx;
  background: var(--color-brand);
  color: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  position: relative;
}

.coupon-left::after {
  content: '';
  position: absolute;
  right: -12rpx;
  top: 0;
  bottom: 0;
  width: 24rpx;
  background: linear-gradient(90deg, transparent 50%, var(--color-bg-white) 50%);
  background-size: 24rpx 16rpx;
}

.coupon-value {
  display: flex;
  align-items: baseline;
}

.value-symbol {
  font-size: 28rpx;
  font-weight: 600;
}

.value-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.value-unit {
  font-size: 24rpx;
  margin-left: 4rpx;
}

.coupon-condition {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.coupon-right {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.coupon-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.coupon-time {
  font-size: 22rpx;
  color: var(--color-text-light);
}

.coupon-status {
  position: absolute;
  top: 50%;
  right: 20rpx;
  transform: translateY(-50%) rotate(-15deg);
  font-size: 24rpx;
  color: var(--color-text-light);
  border: 2px solid var(--color-text-light);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

.coupon-action {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
}

.action-btn {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
}

.action-btn.receive {
  background: var(--color-brand);
  color: white;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 80rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
