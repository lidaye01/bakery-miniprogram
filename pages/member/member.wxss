/* pages/member/member.wxss */
.member-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 40rpx;
}

/* 会员卡片 */
.member-card {
  background: var(--color-brand-gradient);
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  padding: 32rpx;
  padding-top: 48rpx;
  color: white;
}

.member-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.member-avatar {
  width: 112rpx;
  height: 112rpx;
  background: white;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 24rpx;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.member-level {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.25);
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
}

.level-icon {
  font-size: 28rpx;
}

.member-progress {
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-md);
  padding: 20rpx;
}

.progress-info {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: white;
  border-radius: 6rpx;
}

.progress-tip {
  font-size: 22rpx;
  opacity: 0.8;
}

/* 快捷入口 */
.quick-entry {
  display: flex;
  background: var(--color-bg-white);
  margin: 24rpx;
  border-radius: var(--radius-md);
  padding: 24rpx 0;
  box-shadow: var(--shadow-sm);
}

.entry-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1px solid var(--color-border);
}

.entry-item:last-child {
  border-right: none;
}

.entry-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.entry-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-brand);
  margin-bottom: 4rpx;
}

.entry-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 区块 */
.section {
  background: var(--color-bg-white);
  margin: 0 24rpx 20rpx;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

/* 会员权益 */
.rights-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.right-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
}

.right-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.right-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.right-desc {
  font-size: 20rpx;
  color: var(--color-brand);
}

/* 成长任务 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
}

.task-item.completed {
  opacity: 0.6;
}

.task-info {
  display: flex;
  flex-direction: column;
}

.task-name {
  font-size: 26rpx;
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.task-reward {
  font-size: 22rpx;
  color: var(--color-brand);
}

.task-action {
  font-size: 24rpx;
  color: var(--color-success);
}

.do-btn {
  padding: 8rpx 20rpx;
  background: var(--color-brand);
  color: white;
  border-radius: 20rpx;
}

/* 底部安全区 */
.safe-bottom {
  height: 40rpx;
}
