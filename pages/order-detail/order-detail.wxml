<!-- pages/order-detail/order-detail.wxml -->
<view class="order-detail-page">
  <scroll-view class="page-content" scroll-y>
    <!-- 状态大标题 -->
    <view class="status-header status-{{orderDetail.status}}">
      <view class="status-icon">
        <text wx:if="{{orderDetail.status === 'pending'}}">⏰</text>
        <text wx:elif="{{orderDetail.status === 'preparing'}}">👨‍🍳</text>
        <text wx:elif="{{orderDetail.status === 'ready'}}">📦</text>
        <text wx:elif="{{orderDetail.status === 'completed'}}">🎉</text>
        <text wx:else>❌</text>
      </view>
      <view class="status-text">{{orderDetail.statusText}}</view>
      <view class="status-tip" wx:if="{{orderDetail.status === 'preparing'}}">正在为您精心制作中</view>
      <view class="status-tip" wx:if="{{orderDetail.status === 'ready'}}">您的订单已准备好，请尽快取货</view>
    </view>

    <!-- 状态步骤条 -->
    <view class="status-steps">
      <view 
        class="step-item {{step.completed ? 'completed' : ''}} {{step.current ? 'current' : ''}}"
        wx:for="{{statusSteps}}"
        wx:key="index"
      >
        <view class="step-dot">
          <view class="dot-inner" wx:if="{{step.completed}}">✓</view>
        </view>
        <view class="step-line" wx:if="{{index < statusSteps.length - 1}}"></view>
        <view class="step-text">{{item.text}}</view>
        <view class="step-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
      </view>
    </view>

    <!-- 门店信息 -->
    <view class="section store-section">
      <view class="section-header">
        <text class="section-icon">📍</text>
        <text class="section-title">取餐门店</text>
      </view>
      <view class="store-info">
        <view class="store-name">{{orderDetail.storeName}}</view>
        <view class="store-address">{{orderDetail.storeAddress}}</view>
      </view>
      <view class="store-actions">
        <view class="action-btn" bindtap="onContactStore">
          <text>📞</text>
          <text>联系门店</text>
        </view>
      </view>
    </view>

    <!-- 取餐信息 -->
    <view class="section">
      <view class="info-row">
        <text class="info-label">取餐方式</text>
        <text class="info-value">{{orderDetail.orderTypeText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">预约时间</text>
        <text class="info-value">{{orderDetail.pickupTime}}</text>
      </view>
    </view>

    <!-- 商品列表 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">订单商品</text>
        <text class="order-no" bindtap="onCopyOrderNo">{{orderDetail.orderNo}} 📋</text>
      </view>
      <view class="order-items">
        <view class="order-item" wx:for="{{orderDetail.items}}" wx:key="index">
          <view class="item-left">
            <text class="item-emoji">{{item.emoji}}</text>
            <view class="item-info">
              <text class="item-name">{{item.name}}</text>
              <text class="item-spec" wx:if="{{item.spec}}">{{item.spec}}</text>
            </view>
          </view>
          <view class="item-right">
            <text class="item-qty">x{{item.quantity}}</text>
            <text class="item-price">¥{{item.price}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 备注信息 -->
    <view class="section" wx:if="{{orderDetail.remark}}">
      <view class="info-row">
        <text class="info-label">备注</text>
        <text class="info-value">{{orderDetail.remark}}</text>
      </view>
    </view>

    <!-- 价格明细 -->
    <view class="section price-section">
      <view class="price-row">
        <text class="price-label">商品金额</text>
        <text class="price-value">¥{{orderDetail.totalAmount}}</text>
      </view>
      <view class="price-row" wx:if="{{orderDetail.deliveryFee > 0}}">
        <text class="price-label">配送费</text>
        <text class="price-value">¥{{orderDetail.deliveryFee}}</text>
      </view>
      <view class="price-row" wx:if="{{orderDetail.discountAmount > 0}}">
        <text class="price-label">优惠</text>
        <text class="price-value discount">-¥{{orderDetail.discountAmount}}</text>
      </view>
      <view class="price-row total">
        <text class="price-label">实付金额</text>
        <text class="price-value">¥{{orderDetail.payAmount}}</text>
      </view>
    </view>

    <!-- 时间信息 -->
    <view class="section time-section">
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{orderDetail.createTime}}</text>
      </view>
      <view class="info-row" wx:if="{{orderDetail.payTime}}">
        <text class="info-label">支付时间</text>
        <text class="info-value">{{orderDetail.payTime}}</text>
      </view>
    </view>

    <!-- 底部安全区 -->
    <view class="safe-bottom"></view>
  </scroll-view>

  <!-- 底部操作按钮 -->
  <view class="page-footer safe-area-bottom" wx:if="{{actions.length > 0}}">
    <view class="action-group">
      <view 
        class="action-btn {{action.type === 'cancel' ? 'btn-outline' : 'btn-primary'}}"
        wx:for="{{actions}}"
        wx:key="type"
        bindtap="onAction"
        data-type="{{action.type}}"
      >{{action.text}}</view>
    </view>
  </view>
</view>
