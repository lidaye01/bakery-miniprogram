/* pages/order-detail/order-detail.wxss */
.order-detail-page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  padding-bottom: 140rpx;
}

/* 状态大标题 */
.status-header {
  padding: 48rpx 32rpx;
  text-align: center;
  color: white;
}

.status-header.status-pending {
  background: linear-gradient(135deg, #E6A23C 0%, #F0BB7A 100%);
}

.status-header.status-preparing {
  background: linear-gradient(135deg, #D4883A 0%, #E6A65D 100%);
}

.status-header.status-ready {
  background: linear-gradient(135deg, #5D9C59 0%, #7BC47F 100%);
}

.status-header.status-completed {
  background: linear-gradient(135deg, #5D9C59 0%, #7BC47F 100%);
}

.status-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.status-tip {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 状态步骤条 */
.status-steps {
  display: flex;
  justify-content: space-between;
  padding: 32rpx 48rpx;
  background: var(--color-bg-white);
  margin-bottom: 20rpx;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex: 1;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: white;
  margin-bottom: 8rpx;
  z-index: 1;
}

.step-item.completed .step-dot {
  background: var(--color-success);
}

.step-item.current .step-dot {
  background: var(--color-brand);
  box-shadow: 0 0 0 8rpx rgba(212, 136, 58, 0.2);
}

.step-line {
  position: absolute;
  top: 20rpx;
  left: calc(50% + 20rpx);
  width: calc(100% - 40rpx);
  height: 4rpx;
  background: var(--color-border);
}

.step-item.completed .step-line {
  background: var(--color-success);
}

.step-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.step-item.completed .step-text,
.step-item.current .step-text {
  color: var(--color-text);
  font-weight: 500;
}

.step-desc {
  font-size: 20rpx;
  color: var(--color-text-light);
  margin-top: 4rpx;
}

/* 区块 */
.section {
  background: var(--color-bg-white);
  margin: 20rpx 24rpx;
  border-radius: var(--radius-md);
  padding: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.order-no {
  font-size: 24rpx;
  color: var(--color-brand);
}

/* 门店信息 */
.store-section {
  display: flex;
  flex-direction: column;
}

.store-info {
  margin-bottom: 16rpx;
}

.store-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.store-address {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.store-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1px solid var(--color-border);
}

.store-actions .action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  background: var(--color-brand-light);
  color: var(--color-brand);
  font-size: 26rpx;
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.info-value {
  font-size: 28rpx;
  color: var(--color-text);
}

/* 订单商品 */
.order-items {
  border-top: 1px solid var(--color-border);
  padding-top: 16rpx;
}

.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-emoji {
  font-size: 40rpx;
}

.item-name {
  font-size: 28rpx;
  color: var(--color-text);
}

.item-spec {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-qty {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.item-price {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  min-width: 100rpx;
  text-align: right;
}

/* 价格明细 */
.price-section .price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.price-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.price-value {
  font-size: 26rpx;
  color: var(--color-text);
}

.price-value.discount {
  color: var(--color-error);
}

.price-row.total {
  border-top: 1px dashed var(--color-border);
  margin-top: 12rpx;
  padding-top: 20rpx;
}

.price-row.total .price-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.price-row.total .price-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-brand);
}

/* 时间信息 */
.time-section .info-row {
  border-bottom: none;
}

/* 底部操作按钮 */
.page-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-bg-white);
  padding: 20rpx 32rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.action-group {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.action-btn {
  padding: 20rpx 36rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn.btn-primary {
  background: var(--color-brand);
  color: white;
}

.action-btn.btn-outline {
  border: 1px solid var(--color-brand);
  color: var(--color-brand);
  background: transparent;
}

/* 底部安全区 */
.safe-bottom {
  height: 40rpx;
}
