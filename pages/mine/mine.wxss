/* pages/mine/mine.wxss */
.mine-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 40rpx;
}

/* 会员卡片 */
.member-card {
  background: var(--color-brand-gradient);
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  padding: 32rpx;
  padding-top: 48rpx;
  color: white;
}

.member-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.member-avatar {
  width: 112rpx;
  height: 112rpx;
  background: white;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder {
  font-size: 56rpx;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.member-level {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.25);
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
}

.level-icon {
  font-size: 28rpx;
}

.member-arrow {
  font-size: 48rpx;
  opacity: 0.7;
}

.member-progress {
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-md);
  padding: 20rpx;
}

.progress-info {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: white;
  border-radius: 6rpx;
}

.progress-tip {
  font-size: 22rpx;
  opacity: 0.8;
}

/* 数据统计 */
.stats-section {
  display: flex;
  align-items: center;
  background: var(--color-bg-white);
  margin: 24rpx;
  border-radius: var(--radius-md);
  padding: 28rpx 0;
  box-shadow: var(--shadow-sm);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-brand);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.stat-divider {
  width: 1px;
  height: 60rpx;
  background: var(--color-border);
}

/* 功能菜单 */
.menu-section {
  background: var(--color-bg-white);
  margin: 0 24rpx 20rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1px solid var(--color-border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon {
  font-size: 36rpx;
}

.menu-name {
  font-size: 28rpx;
  color: var(--color-text);
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--color-text-light);
}

/* 会员权益 */
.rights-section {
  background: var(--color-bg-white);
  margin: 0 24rpx;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.rights-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.rights-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.right-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.right-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.right-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 底部安全区 */
.safe-bottom {
  height: 40rpx;
}
