<!-- pages/addresses/addresses.wxml -->
<view class="addresses-page">
  <view class="address-list">
    <view 
      class="address-card"
      wx:for="{{addresses}}"
      wx:key="id"
      bindtap="onSelectAddress"
      data-address="{{item}}"
    >
      <view class="address-main">
        <view class="address-user">
          <text class="user-name">{{item.name}}</text>
          <text class="user-phone">{{item.phone}}</text>
          <view class="default-tag" wx:if="{{item.isDefault}}">默认</view>
        </view>
        <view class="address-detail">
          {{item.province}}{{item.city}}{{item.district}}{{item.detail}}
        </view>
      </view>
      <view class="address-actions">
        <view class="action-btn" bindtap="onSetDefault" data-address="{{item}}">设为默认</view>
        <view class="action-btn" bindtap="onEditAddress" data-address="{{item}}">编辑</view>
        <view class="action-btn delete" bindtap="onDeleteAddress" data-address="{{item}}">删除</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{addresses.length === 0}}">
    <view class="empty-icon">📍</view>
    <view class="empty-text">暂无收货地址</view>
    <button class="empty-btn" bindtap="onAddAddress">添加地址</button>
  </view>

  <!-- 添加地址按钮 -->
  <view class="add-btn-bar safe-area-bottom" wx:if="{{addresses.length > 0}}">
    <button class="add-btn" bindtap="onAddAddress">+ 添加新地址</button>
  </view>
</view>
