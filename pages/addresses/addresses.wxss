/* pages/addresses/addresses.wxss */
.addresses-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 140rpx;
}

.address-list {
  padding: 24rpx;
}

.address-card {
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.address-main {
  padding-bottom: 16rpx;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 16rpx;
}

.address-user {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.user-phone {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.default-tag {
  padding: 4rpx 12rpx;
  background: var(--color-brand-light);
  color: var(--color-brand);
  font-size: 20rpx;
  border-radius: var(--radius-sm);
}

.address-detail {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.address-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 8rpx 20rpx;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  border: 1px solid var(--color-border);
  border-radius: 20rpx;
}

.action-btn.delete {
  color: var(--color-error);
  border-color: var(--color-error);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 80rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 48rpx;
}

.empty-btn {
  background: var(--color-brand);
  color: white;
  font-size: 28rpx;
  padding: 24rpx 64rpx;
  border-radius: 50rpx;
  border: none;
}

.empty-btn::after {
  border: none;
}

/* 添加地址按钮 */
.add-btn-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--color-bg-white);
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
}

.add-btn {
  width: 100%;
  background: var(--color-brand);
  color: white;
  font-size: 30rpx;
  font-weight: 500;
  padding: 28rpx;
  border-radius: 50rpx;
  border: none;
}

.add-btn::after {
  border: none;
}
