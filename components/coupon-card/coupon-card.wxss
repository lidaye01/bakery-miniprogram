/* coupon-card/coupon-card.wxss */
.coupon-card {
  display: flex;
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
  margin-bottom: 24rpx;
}

.coupon-card.unavailable {
  opacity: 0.6;
}

.coupon-card.unavailable .coupon-left {
  background: var(--color-text-light);
}

.coupon-left {
  width: 200rpx;
  background: var(--color-brand);
  color: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  position: relative;
}

.coupon-left::after {
  content: '';
  position: absolute;
  right: -12rpx;
  top: 0;
  bottom: 0;
  width: 24rpx;
  background: linear-gradient(90deg, transparent 50%, var(--color-bg-white) 50%);
  background-size: 24rpx 16rpx;
}

.coupon-value {
  display: flex;
  align-items: baseline;
}

.value-symbol {
  font-size: 28rpx;
  font-weight: 600;
}

.value-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.value-unit {
  font-size: 24rpx;
  margin-left: 4rpx;
}

.coupon-condition {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.coupon-right {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.coupon-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.coupon-time {
  font-size: 22rpx;
  color: var(--color-text-light);
}

.coupon-action {
  margin-top: 12rpx;
}

.action-btn {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
}

.receive-btn {
  background: var(--color-brand);
  color: white;
}

.use-btn {
  background: var(--color-brand);
  color: white;
}

.unavailable-btn {
  background: var(--color-border);
  color: var(--color-text-light);
}

.coupon-status-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  background: var(--color-error);
  color: white;
}
