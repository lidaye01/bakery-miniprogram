/* cart-bar/cart-bar.wxss */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: var(--color-bg-white);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.cart-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.cart-icon {
  width: 96rpx;
  height: 96rpx;
  background: var(--color-text-light);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  position: relative;
  transition: all 0.2s;
}

.cart-icon.active {
  background: var(--color-brand);
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  background: var(--color-error);
  color: white;
  border-radius: 18rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.cart-text strong {
  font-size: 36rpx;
  color: var(--color-brand);
  font-weight: 700;
}

.checkout-btn {
  background: var(--color-brand);
  color: white;
  padding: 24rpx 48rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.checkout-btn.disabled {
  background: var(--color-border);
  color: var(--color-text-light);
}

.checkout-btn:active:not(.disabled) {
  opacity: 0.9;
}
