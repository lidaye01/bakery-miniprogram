/* order-card/order-card.wxss */
.order-card {
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1px solid var(--color-border);
}

.order-store {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.order-status {
  font-size: 26rpx;
  font-weight: 500;
}

.order-status.status-pending { color: var(--color-warning); }
.order-status.status-paid { color: var(--color-info); }
.order-status.status-preparing { color: var(--color-brand); }
.order-status.status-ready { color: var(--color-brand); }
.order-status.status-completed { color: var(--color-success); }
.order-status.status-cancelled { color: var(--color-text-light); }

.order-items {
  margin-bottom: 20rpx;
}

.order-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
  font-size: 26rpx;
}

.item-emoji {
  font-size: 32rpx;
}

.item-name {
  flex: 1;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-qty {
  color: var(--color-text-secondary);
  margin-right: 16rpx;
}

.item-price {
  color: var(--color-text);
  font-weight: 500;
}

.order-more {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  padding: 8rpx 0;
}

.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1px solid var(--color-border);
}

.order-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.order-amount {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.order-amount .amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.order-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1px dashed var(--color-border);
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  border: 1px solid var(--color-border);
  color: var(--color-text-secondary);
}

.action-btn.btn-pay,
.action-btn.btn-confirm {
  background: var(--color-brand);
  color: white;
  border-color: var(--color-brand);
}

.action-btn.btn-remind {
  border-color: var(--color-brand);
  color: var(--color-brand);
}

.action-btn:active {
  opacity: 0.8;
}
