/* product-card/product-card.wxss */
.product-card {
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  position: relative;
}

.product-image {
  width: 100%;
  height: 200rpx;
  background: var(--color-brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-image image {
  width: 100%;
  height: 100%;
}

.product-info {
  padding: 24rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.product-price .current {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.product-price .original {
  font-size: 24rpx;
  color: var(--color-text-light);
  text-decoration: line-through;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  background: var(--color-brand);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

.add-btn:active {
  opacity: 0.8;
}

.product-tag {
  position: absolute;
  top: 16rpx;
  left: 0;
  background: var(--color-brand);
  color: white;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}
